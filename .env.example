# 복사해서 .env 로 쓰세요:  cp .env.example .env
# 채널 관리자센터 URL business.kakao.com/{이값}/chats 의 {이값}
KBC_PROFILE_ID=_XXXXX
# Chrome 프로필명(미지정 시 _kawlt 보유 프로필 자동탐지). 예: "Default", "Profile 1"
# KBC_CHROME_PROFILE=Default
# Chrome 쿠키 자동추출 대신 고정 Cookie 헤더 주입(고급)
# KBC_COOKIE=
# autoreply/daemon 기본 답장 문구
# KBC_REPLY=안녕하세요! 확인 후 빠르게 답변드리겠습니다 🙌
# daemon 자동응답 켜기(1)
# KBC_AUTOREPLY=0
